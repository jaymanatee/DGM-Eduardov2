# Copia este fichero a .env y rellena lo que necesites. .env está en .gitignore.

# Token de Hugging Face (solo hace falta para modelos con acceso restringido)
HF_TOKEN=

# Dónde guardar los modelos descargados. En la DGX conviene apuntar a un disco compartido.
HF_HOME=./hf_cache

# Qué GPUs ve el proceso. En la DGX NO lo toquéis: SLURM lo fija a la partición que os asigna.
# Solo tiene sentido en una máquina propia con varias GPUs, por ejemplo "0" o "2,3".
# CUDA_VISIBLE_DEVICES=0

# Puerto de la API
ARCA_API_PORT=8000

# Fase 1: adaptador que sirve POST /reasoning (descargadlo de Hugging Face) y su verificador
ARCA_RLM_ADAPTER=rlm/weights/grpo_pps3
ARCA_RLM_VERIFIER=origin

# Fase 2: modelo que sirve POST /tools (off la desactiva). Ver tool_use/executor.py.
ARCA_TOOLS_MODEL=Qwen/Qwen3-1.7B
# SFT de tool use (hf download enriquefbrt/arca-tools-sft-lora). Se sirve sin thinking: se entrenó
# así. Vacío = Qwen3-1.7B sin ajustar (entrada de EXPERIMENTS del 10/11, SFT para tool use (2)).
ARCA_TOOLS_ADAPTER=tool_use/weights/sft_nothink
ARCA_TOOLS_THINKING=0
# ARCA_TOOLS_PROMPT=slides     # slides (plantilla a mano) o native (la del chat template de Qwen)
# ARCA_TOOLS_MAX_NEW_TOKENS=   # por defecto 1024, o 4096 con thinking
# ARCA_TOOLS_CONFIRM=auto      # auto o deny: qué pasa con issue_origin_statement
# ARCA_STATEMENTS_DIR=outputs/origin_statements
